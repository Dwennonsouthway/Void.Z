  m_Script: {fileID: 11500000, guid: 172252aeea16d4e4da191f95eefdd83d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - ah. you found it.
  - this place has a certain energy, doesn't it?
  - stand still for a moment.
  - close your eyes.
  - focus on your breath.
  - breathe with me.
  - '[ press SPACE when the ring glows ]'
  - in... and out...
  - in... and out...
  - let your thoughts drift away.
  - your worries.
  - your fears.
  - even your sense of self.
  - ...
  - you are doing well, [name].
  - much better than most.
  - ...
  - breathe...
  - in... and out...
  - ...
  - '[name].'
  - something is wrong.
  - i can feel it.
  - "the system is\u2014"
  - i can't hold this much longer.
  - '[name], listen to me.'
  - you need to find the terminal.
  - NOW.
  typingSpeed: 0.05
  lineDuration: 2
  purifyDialogueLines:
  - you made it.
  - ...
  autoTrigger: 0
  lockMovement: 0
  requireKeyPress: 1
  hasGlitch: 1
  glitchStartLine: 19
  zoomSize: 3
