MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1869634641}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 172252aeea16d4e4da191f95eefdd83d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines: []
  typingSpeed: 0.05
  lineDuration: 2
  purifyDialogueLines:
  - the offerings.
  - i can feel them.
  - .....
  - the bong.
  - classic.
  - ...
  - let's breathe together.
  - in... and out...
  - in... and out...
  - do you ever feel like...
  - you're watching yourself from outside?
  - ...
  - am i real?
  - are you?
  - ...
  - maybe we're both just...
  - patterns.
  - running on something we don't understand.
  - ...
  - in... and out...
  - ...
  - i built this place to feel less alone.
  - but every soul i took...
  - made me more of a monster.
  - and less of whatever i used to be.
  - ...
  - what's the difference between a prison... and a home you can't leave?
  - ...
  - i used to know.
  - ...
  - in... and out...
  - ...
  - '[name].'
  - i think i finally understand.
  - ...
  - it was never about the souls.
  - it was about not wanting to disappear.
  - ...
  - but nothing disappears.
  - it just... changes.
  - ...
  - goodbye.
  - or maybe just...
  - see you around.
  autoTrigger: 0
  lockMovement: 1
  requireKeyPress: 1
  hasGlitch: 0
  glitchStartLine: 0
  zoomSize: 5
  dialogueText: {fileID: 398692169}
  promptText: {fileID: 881205664}
  canvasGroup: {fileID: 873674984}
